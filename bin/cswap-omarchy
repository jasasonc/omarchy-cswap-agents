#!/usr/bin/env python3
"""Show claude-swap (cswap) account usage in the Omarchy Agents panel.

Reads `cswap list --json` and writes one record per inactive account to
~/.local/state/omarchy/agents/usage/cswap-<name>.json. The panel shows every
record in that folder as a tab. The active account is left to Omarchy's
built-in Claude Code tab, so it does not show twice.
"""

import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

PREFIX = "cswap-"
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
USAGE_DIR = STATE_HOME / "omarchy" / "agents" / "usage"
STATUS_DIR = STATE_HOME / "cswap-omarchy"


def log(message: str) -> None:
  print(f"cswap-omarchy: {message}", file=sys.stderr)


def cswap_binary() -> str | None:
  # The shell can start without ~/.local/bin on PATH, so also look where uv puts tools.
  found = shutil.which("cswap")
  if found:
    return found
  home = Path.home()
  data_home = Path(os.environ.get("XDG_DATA_HOME") or home / ".local/share")
  candidates = [
    Path(os.environ["UV_TOOL_BIN_DIR"]) / "cswap" if os.environ.get("UV_TOOL_BIN_DIR") else None,
    Path(os.environ["XDG_BIN_HOME"]) / "cswap" if os.environ.get("XDG_BIN_HOME") else None,
    home / ".local/bin/cswap",
    Path(os.environ.get("UV_TOOL_DIR") or data_home / "uv/tools") / "claude-swap/bin/cswap",
  ]
  for candidate in candidates:
    if candidate and candidate.is_file() and os.access(candidate, os.X_OK):
      return str(candidate)
  return None


def parse_time(value) -> dt.datetime | None:
  if not value:
    return None
  try:
    parsed = dt.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
  except ValueError:
    return None
  return parsed if parsed.tzinfo else parsed.replace(tzinfo=dt.timezone.utc)


def limit_window(label: str, entry, title: str = "") -> dict | None:
  if not isinstance(entry, dict) or entry.get("pct") is None:
    return None
  try:
    percent = float(entry["pct"]) / 100
  except (TypeError, ValueError):
    return None
  reset = parse_time(entry.get("resetsAt"))
  # A window that reset after the numbers were read no longer holds them.
  if reset and reset <= dt.datetime.now(dt.timezone.utc):
    return None
  window = {"label": label, "percent": max(0.0, min(1.0, percent))}
  if reset:
    window["resetsAt"] = reset.isoformat()
  if title:
    window["title"] = title
  return window


def limits_from(usage) -> list[dict]:
  if not isinstance(usage, dict):
    return []
  windows = [
    limit_window("Session (5-hour)", usage.get("fiveHour")),
    limit_window("Weekly (7-day)", usage.get("sevenDay")),
  ]
  for scoped in usage.get("scoped") or []:
    name = str((scoped or {}).get("name") or "").strip()
    if name:
      windows.append(limit_window(f"{name} Weekly", scoped, f"{name} Weekly"))
  return [w for w in windows if w]


def age_text(seconds) -> str:
  minutes = int((seconds or 0) // 60)
  if minutes < 1:
    return "just now"
  if minutes < 60:
    return f"{minutes} min ago"
  hours = minutes // 60
  return f"{hours} h ago" if hours < 48 else f"{hours // 24} days ago"


def slugify(text: str) -> str:
  return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def names_for(accounts: list[dict]) -> list[str]:
  """One unique tab name per account, in account order.

  The name is the alias set with `cswap alias`, else the email name before
  the @. Accounts without an alias whose email names clash use the full
  email. A name that is still not unique gets the account number.
  """
  def short(account: dict) -> str:
    return slugify(str(account.get("alias") or "") or str(account.get("email") or "").split("@")[0])

  short_names = [short(a) for a in accounts]
  names = []
  for account, name in zip(accounts, short_names):
    if short_names.count(name) > 1 and not account.get("alias"):
      name = slugify(str(account.get("email") or "")) or name
    names.append(name)

  unique = []
  for account, name in zip(accounts, names):
    if not name:
      name = f"account-{account.get('number')}"
    elif names.count(name) > 1:
      name = f"{name}-{account.get('number')}"
    unique.append(name)
  return unique


def record_for(account: dict, slug: str) -> dict:
  email = str(account.get("email") or "")
  status = str(account.get("usageStatus") or "")
  usage = account.get("usage")
  status_text = ""
  help_text = ""

  if isinstance(usage, dict):
    limits = limits_from(usage)
    age = account.get("usageAgeSeconds") or 0
    if age > 600:
      status_text = f"Updated {age_text(age)}"
  else:
    limits = limits_from(account.get("lastGoodUsage"))
    last_known = f", last known {age_text(account.get('lastGoodAgeSeconds'))}" if limits else ""
    if status in ("token_expired", "relogin_required"):
      status_text = "Sign-in expired" + last_known
      help_text = f"Log in to Claude Code as {email}, then run: cswap add"
    else:
      status_text = "Usage unavailable" + last_known
      error = account.get("usageError")
      help_text = f"cswap could not read the usage ({error})." if error else "cswap could not read the usage."

  # The panel hides a tab with no limits at all. A negative percent keeps the
  # tab, so an error stays visible, and the panel draws no meter for it.
  if not limits:
    limits = [{"label": "Weekly (7-day)", "percent": -1}]

  tier = email + (" (disabled in cswap)" if account.get("disabled") else "")
  return {
    "schemaVersion": 1,
    "id": PREFIX + slug,
    "name": slug,
    "cswapNumber": account.get("number"),
    "cswapEmail": email,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": True,
    "hasLocalStats": False,
    "hasPromptStats": False,
    "tierLabel": tier,
    "usageStatusText": status_text,
    "authHelpText": help_text,
    "limits": limits,
  }


def write_if_changed(path: Path, record: dict) -> None:
  def same(a: dict, b: dict) -> bool:
    return {k: v for k, v in a.items() if k != "updatedAt"} == {k: v for k, v in b.items() if k != "updatedAt"}

  try:
    if same(json.loads(path.read_text(encoding="utf-8")), record):
      return
  except (OSError, ValueError):
    pass
  # The temp name does not end in .json, so the panel never reads a half-written file.
  fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.stem}.")
  with os.fdopen(fd, "w", encoding="utf-8") as handle:
    json.dump(record, handle, separators=(",", ":"), sort_keys=True)
    handle.write("\n")
  os.replace(tmp, path)


def write_status(state: str, cswap: str | None = None, message: str = "", accounts: int = 0, records=()) -> None:
  # The panel watches this file. It shows setup help from the state, and it
  # rescans the usage folder when the file changes, also after a run from
  # bin/cswap-add-account.
  STATUS_DIR.mkdir(parents=True, exist_ok=True)
  write_if_changed(STATUS_DIR / "status.json", {
    "state": state,
    "message": message,
    "cswapPath": cswap or "",
    "accounts": accounts,
    "records": sorted(records),
  })


def remove_account_tabs(keep=()) -> None:
  if USAGE_DIR.is_dir():
    for path in USAGE_DIR.glob(PREFIX + "*.json"):
      if path.name not in keep:
        path.unlink(missing_ok=True)


def main() -> int:
  cswap = cswap_binary()
  if not cswap:
    # Without claude-swap there are no account tabs. The panel shows how to install it.
    remove_account_tabs()
    (STATUS_DIR / "active.json").unlink(missing_ok=True)
    write_status("missing")
    return 0
  try:
    result = subprocess.run([cswap, "list", "--json"], capture_output=True, text=True, timeout=120, check=True)
    data = json.loads(result.stdout)
  except subprocess.CalledProcessError as exc:
    message = f"cswap list failed: {exc.stderr.strip() or exc}"
  except (subprocess.TimeoutExpired, ValueError) as exc:
    message = f"cswap list failed: {exc}"
  else:
    message = "" if isinstance(data, dict) else "cswap list returned no account list"
  if message:
    # Keep the last tabs: a failed run is often temporary.
    log(message)
    write_status("error", cswap, message)
    return 1

  accounts = data.get("accounts") or []
  active_number = data.get("activeAccountNumber")
  USAGE_DIR.mkdir(parents=True, exist_ok=True)

  def is_active(account: dict) -> bool:
    return bool(account.get("active")) or (active_number is not None and account.get("number") == active_number)

  names = names_for(accounts)

  # The panel names the built-in Claude Code tab after the active account.
  active_path = STATUS_DIR / "active.json"
  active_index = next((i for i, a in enumerate(accounts) if is_active(a)), None)
  if active_index is not None:
    active = accounts[active_index]
    active_path.parent.mkdir(parents=True, exist_ok=True)
    write_if_changed(active_path, {"number": active.get("number"), "name": names[active_index], "email": active.get("email") or ""})
  else:
    active_path.unlink(missing_ok=True)

  written = set()
  for account, name in zip(accounts, names):
    if is_active(account):
      continue
    path = USAGE_DIR / f"{PREFIX}{name}.json"
    write_if_changed(path, record_for(account, name))
    written.add(path.name)

  # Remove tabs for accounts that became active or left cswap.
  remove_account_tabs(keep=written)
  write_status("ok" if accounts else "no-accounts", cswap, accounts=len(accounts), records=written)
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
